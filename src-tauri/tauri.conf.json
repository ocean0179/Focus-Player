{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Focus Player",
  "version": "0.1.3",
  "identifier": "com.ocean.focusplayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5500"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Focus Player",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVBQjgxRDRCNjIwODYzMUYKUldRZll3aGlTeDI0NmlyVUNhSkFOTkcwUVI0S1UydDBXYUM1MGlXUFcwcW1Vai9PYWpYRjBGakIK",
      "endpoints": [
        "https://github.com/ocean0179/Focus-Player/releases/latest/download/latest.json"
      ]
    }
  }
}
